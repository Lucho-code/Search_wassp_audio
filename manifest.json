{
  "manifest_version": 3,
  "name": "WhatsApp Web - Búsqueda en Audios",
  "version": "1.0.0",
  "description": "Extiende la búsqueda de WhatsApp Web para incluir transcripciones de notas de voz, procesadas 100% en el navegador (sin enviar audio a ningún servidor).",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Búsqueda en audios de WhatsApp"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*", "models/*"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
